{
  "name": "@spinejit/pi-spinejit",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "author": "GhabiX",
  "description": "SpineJIT context management for Pi, backed by the portable Spine SDK.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GhabiX/spine-sdk-plugin.git",
    "directory": "packages/plugin"
  },
  "bugs": {
    "url": "https://github.com/GhabiX/spine-sdk-plugin/issues"
  },
  "homepage": "https://github.com/GhabiX/spine-sdk-plugin#readme",
  "keywords": [
    "pi-package",
    "spinejit"
  ],
  "pi": {
    "extensions": [
      "./dist/pi/extension.js"
    ]
  },
  "exports": {
    "./pi/tree-view": {
      "types": "./dist/pi/tree-view-contract.d.ts",
      "import": "./dist/pi/tree-view-contract.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "import": "./dist/pi/index.js"
    },
    "./pi/extension": {
      "types": "./dist/pi/extension.d.ts",
      "import": "./dist/pi/extension.js"
    },
    "./pi/tree-style": {
      "types": "./dist/pi/tree-style.d.ts",
      "import": "./dist/pi/tree-style.js"
    },
    "./deepseek-harness": {
      "types": "./dist/deepseek-harness/index.d.ts",
      "import": "./dist/deepseek-harness/index.js"
    },
    "./deepseek-harness/extension": {
      "types": "./dist/deepseek-harness/extension.d.ts",
      "import": "./dist/deepseek-harness/extension.js"
    }
  },
  "files": [
    "README.md",
    "dist",
    "spine.toml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@spinejit/spine-host": "0.1.0",
    "@spinejit/spine-sdk": "0.1.0",
    "typebox": "1.3.7",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2"
  }
}
